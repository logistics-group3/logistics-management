# =====================================================================
# 사용법: 이 파일을 복사해 .env 를 만든다 →  cp .env.example .env
# .env 는 Git 에 올리지 않는다 (.gitignore 에 등록됨)
# =====================================================================

# PostgreSQL 관리자 계정 (컨테이너 생성용)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 서비스별 DB 계정 비밀번호 — infra/postgres/init.sql 의 값과 같아야 한다
USER_DB_PASSWORD=user_local_pw
HUB_DB_PASSWORD=hub_local_pw
COMPANY_DB_PASSWORD=company_local_pw
ORDER_DB_PASSWORD=order_local_pw
DELIVERY_DB_PASSWORD=delivery_local_pw

# JWT 서명 키 — user-service(발급)와 gateway(검증)가 공유. 32바이트(영문 32자) 이상
# 생성 예:  openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-key-change-me-0123456789

# 초기 MASTER 계정 비밀번호 (username: master)
MASTER_PASSWORD=Master!2026

# order-service Slack 알림 (주문 생성 시)
SLACK_WEBHOOK_URL=
