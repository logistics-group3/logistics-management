# cp .env.example .env  →  값을 채운 .env는 커밋하지 않는다 (.gitignore)
# 새 변수를 추가하면 여기에 더미 값으로 적고 docker-compose.yml environment에도 추가 (doc/guide/12-config-ops.md)

# JWT 서명 키 — gateway·user-service 공유, 32바이트 이상 (필수)
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# 서비스별 DB 비밀번호 (DB 컨테이너와 서비스에 같은 값이 들어감)
USER_DB_PASSWORD=user_pw
HUB_DB_PASSWORD=hub_pw
COMPANY_DB_PASSWORD=company_pw
ORDER_DB_PASSWORD=order_pw
DELIVERY_DB_PASSWORD=delivery_pw

# 최초 MASTER 계정 (user-service 기동 시 없으면 생성)
MASTER_USERNAME=master01
MASTER_PASSWORD=Master!234

# Slack Incoming Webhook (비워두면 알림 생략)
SLACK_WEBHOOK_URL=
