# 복사해서 사용: cp .env.example .env  (.env는 Git에 올리지 않는다)

# PostgreSQL
POSTGRES_PASSWORD=postgres_local_pw
POSTGRES_HOST_PORT=5432
USER_DB_PASSWORD=user_local_pw
HUB_DB_PASSWORD=hub_local_pw
COMPANY_DB_PASSWORD=company_local_pw
ORDER_DB_PASSWORD=order_local_pw
DELIVERY_DB_PASSWORD=delivery_local_pw

# JWT (HS256, Base64 인코딩된 32바이트 이상 키)
# 생성 예: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=3600000

# 초기 MASTER 계정 (user-service 기동 시 없으면 생성, 비워 두면 생략). username은 4~10자
MASTER_USERNAME=master
MASTER_PASSWORD=master_local_pw

# Slack Incoming Webhook (비워 두면 알림 생략)
SLACK_WEBHOOK_URL=
