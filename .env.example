# cp .env.example .env 후 사용한다. .env는 커밋하지 않는다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_pw

# infra/postgres/init.sh가 최초 빈 DB에 이 값으로 서비스 계정을 만든다.
# 기존 볼륨의 계정 비밀번호는 이 파일을 바꿔도 자동 갱신되지 않는다.
USER_DB_PASSWORD=user_local_pw
HUB_DB_PASSWORD=hub_local_pw
COMPANY_DB_PASSWORD=company_local_pw
ORDER_DB_PASSWORD=order_local_pw
DELIVERY_DB_PASSWORD=delivery_local_pw

# user-service가 기동할 때 이 계정이 없으면 MASTER로 만든다. 비워 두면 만들지 않는다.
# username은 소문자·숫자 4~10자. 로컬 전용 값이다.
MASTER_USERNAME=master
MASTER_PASSWORD=Master!2026

# HS256 서명 키. 32바이트 이상
JWT_SECRET=local-only-jwt-secret-key-change-me-0123456789

SLACK_WEBHOOK_URL=
# 배송담당자 이메일 기반 DM. 봇 토큰은 실제 환경 파일에만 넣는다.
SLACK_DM_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_DM_WORKSPACE_ID=
SLACK_DM_API_BASE_URL=https://slack.com/api
# 선택 수신자 허용 목록(쉼표 구분). 로컬 UI 테스트에서 DM을 켜려면 반드시 지정한다.
SLACK_DM_ALLOWED_EMAILS=

# 기존 실행 환경과 병행할 때 호스트 포트와 Compose 프로젝트 이름을 다르게 설정한다.
# 컨테이너 사이 통신 포트는 바뀌지 않는다. IDE로 서비스를 띄우면 실행 설정의 DB_PORT도 POSTGRES_PORT와 같게 둔다.
POSTGRES_PORT=5432
CONFIG_SERVER_PORT=8888
EUREKA_PORT=8761
GATEWAY_PORT=8080
# 분산 추적 화면(Zipkin). 이 PC에서만 열린다.
ZIPKIN_PORT=9411
# 추적할 요청 비율(0.0~1.0). 로컬은 1.0(모든 요청). 요청이 많을 때 낮춘다.
TRACING_SAMPLING_PROBABILITY=1.0
# 메트릭 수집(Prometheus)과 대시보드(Grafana) 화면. 이 PC에서만 열린다(ADR 0018).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Grafana 편집용 admin 계정 비밀번호(로컬 더미 값). 보기는 로그인 없이 된다. 127.0.0.1에만 열린다.
GRAFANA_ADMIN_PASSWORD=GrafanaLocal!2026
# COMPOSE_PROJECT_NAME=logistics-integration
