{
  "uid": "perf-master",
  "title": "배송 성능 마스터 측정",
  "description": "delivery-service/docs/perf-master.md 6절 캡처용. load-test/perf/capture.sh가 Grafana API로 올리고 패널마다 PNG로 뽑는다.",
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "delivery p95 (uri별)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "interval": "5s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{uri}}",
          "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{application=\"delivery-service\", uri=~\"/api/v1/deliveries.*\"}[20s])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "delivery Hikari active · pending",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "interval": "5s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "active",
          "expr": "sum(hikaricp_connections_active{application=\"delivery-service\"})"
        },
        {
          "refId": "B",
          "legendFormat": "pending",
          "expr": "sum(hikaricp_connections_pending{application=\"delivery-service\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "axisSoftMax": 12
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "delivery Tomcat 바쁜 스레드",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "interval": "5s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "busy",
          "expr": "sum(tomcat_threads_busy_threads{application=\"delivery-service\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "프로세스 CPU (서비스별)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "interval": "5s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{application}}",
          "expr": "process_cpu_usage{job=\"logistics-services\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "delivery 초당 요청 (uri별)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "interval": "5s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{uri}} {{status}}",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{application=\"delivery-service\", uri=~\"/api/v1/deliveries.*\"}[20s]))"
        }
      ]
    }
  ]
}
