        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(sum by (application, method, uri, status) (http_server_requests_seconds_count{application=~\"$application\", application!=\"gateway-service\", uri!~\"/actuator.*|/internal/.*\"}))",
          "legendFormat": "",
