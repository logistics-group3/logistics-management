      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "내부 API가 받은 호출 (서비스 시작 이후)",
      "description": "다른 서비스가 Feign으로 부른 /internal/** API를 받는 쪽에서 센다. Gateway는 /internal을 외부에 열지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(sum by (application, method, uri, status) (http_server_requests_seconds_count{uri=~\"/internal/.*\"}))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "호출 수",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "호출 수",
              "application": "서비스",
              "method": "메서드",
              "uri": "경로",
              "status": "상태"
            }
          }
        }
      ]
    },
    {
