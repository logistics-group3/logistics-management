          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (application, client, le) (label_replace(rate(feign_client_requests_seconds_bucket[$__rate_interval]), \"client\", \"$1\", \"clientName\", \".*\\\\.([^.]+)$\")))",
          "legendFormat": "{{application}} → {{client}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
